# ─────────────────────────────────────────────────────────────────────────
# AutoActe — Local Environment
# Copy this to .env.local and fill in keys you have. Anything left blank
# will fall back to local-stub adapters (mock data, no external calls).
# ─────────────────────────────────────────────────────────────────────────

# Supabase (optional locally — leave blank to use in-memory mock)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI (optional — Claude Vision OCR + assistant)
ANTHROPIC_API_KEY=
# Optional: model used for document OCR (default claude-sonnet-5-5)
ANTHROPIC_OCR_MODEL=

# Voice (optional — ElevenLabs)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Notifications (optional — Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=AutoActe <noreply@autoacte.ro>

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
WEBHOOK_SIGNING_SECRET=dev-secret-change-me-openssl-rand-hex-32
# HMAC key for the session + 2FA cookies (openssl rand -hex 32). Required in
# production; left blank in dev, a random per-process key is used and every
# restart logs everyone out.
AUTH_SESSION_SECRET=

# Demo seed
NEXT_PUBLIC_DEMO_MODE=true
